# Vorlage: install.sh ersetzt @DIR@ durch den Projektordner.
[Unit]
Description=Wichtelhaus - simulierter Wichtel mit Licht, Ofen und Aussenlicht
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
# NeoPixel an GPIO 18 braucht root (DMA/PWM)
User=root
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/python -m wichtelhaus --config @DIR@/config.yaml
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
